# ============================================================
# InstantStore Server - Environment Configuration Template
# For Localhost: Copy to .env
# For Render: Set these in Render Dashboard -> Environment Variables
# ============================================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas Dashboard -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/instantstore?retryWrites=true&w=majority&authSource=admin

# JWT Secret for Session & Tenant Tokens
JWT_SECRET=instantstore_super_secret_jwt_key_2026

# Domain Routing
BASE_DOMAIN=localhost
BASE_PARENT_DOMAIN=devtackle.in

# Clerk Authentication (Dual-store with MongoDB Atlas)
# Get these from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Cloudinary CDN Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
